# Settings for the scripts in this folder on this server. Copy to `.env` next to this file and
# edit:
#
#   cp env.example .env
#
# `.env` is gitignored, so it stays on the server, untouched, across deploys. Everything here is
# optional: the scripts run with the defaults below when the file is missing. This is a plain
# KEY=value file sourced by bash, so no spaces around `=`, and values with spaces must be quoted.
#
# The app's own `.env` (DATABASE_URL, API_URL, ...) is the one at the repository root, not this.

# --- Where things are ---

# Folder holding the node and npm binaries. Change it when cPanel's Node.js package changes (for
# example to ea-nodejs24).
#NODE_BIN_DIR=/opt/cpanel/ea-nodejs22/bin

# --- PM2 processes (deploy.sh) ---

# The pm2 process names. deploy.sh restarts them when they exist and starts them when they do not.
#API_PROCESS_NAME=wizda-api
#WEB_PROCESS_NAME=wizda-web

# Port and interface the frontend listens on. Ports are per machine, not per cPanel account, so
# pick ones no other app on the box uses. Keep the interface on loopback: the site is reached only
# through Apache's reverse proxy (see DEPLOY.md, "Security: network exposure").
#WEB_PORT=4000
#WEB_HOST=127.0.0.1

# The port the API listens on is read from PORT in the root .env (default 3001); deploy.sh only
# uses it for the health check after the restart. Set this to override what it reads.
#API_PORT=

# How long deploy.sh waits for both processes to answer after the restart, in seconds.
#HEALTH_TIMEOUT=60

# --- Build (deploy.sh) ---

# Refuse to build when the virtual memory limit (ulimit -v) is below this many GB. deploy.sh logs
# the limit on every run; set this once you know what the build needs on this server, because under
# a too-tight limit the build does not fail cleanly but thrashes for minutes first. Unset: log only.
#MIN_VM_LIMIT_GB=

# --- Both scripts ---

# A deploy and a seed never run at the same time. The second one waits this many seconds for the
# first to finish before giving up.
#LOCK_FILE=$HOME/.wizda-tasks.lock
#LOCK_TIMEOUT=1800
